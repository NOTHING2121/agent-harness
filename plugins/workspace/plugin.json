{
  "api_version": 1,
  "id": "workspace",
  "name": "Workspace",
  "version": "1.0.0",
  "description": "只读访问用户指定的目录：列出文件、按行读取文件、搜索文本",
  "harness_version": ">=0.1,<1.0",
  "entry": "main.py",
  "permissions": {
    "network": false,
    "filesystem": true,
    "subprocess": false,
    "env": []
  },
  "config_schema": {
    "type": "object",
    "properties": {
      "root": {
        "type": "string",
        "pattern": "^/",
        "description": "允许访问的目录（绝对路径），插件只读取该目录内的文件"
      },
      "max_file_bytes": {
        "type": "integer",
        "minimum": 1024,
        "default": 1048576,
        "description": "超过这个大小的文件不读取、不搜索"
      }
    },
    "required": ["root"],
    "additionalProperties": false
  },
  "tools": [
    {
      "name": "list_files",
      "description": "列出目录中的文件和子目录（路径相对于 root），支持递归和分页；返回 total 和 next_offset（没有更多时为 null）",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": { "type": "string", "default": ".", "description": "相对于 root 的目录" },
          "recursive": { "type": "boolean", "default": false, "description": "是否包含子目录中的文件" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200, "default": 100, "description": "每页数量" },
          "offset": { "type": "integer", "minimum": 0, "default": 0, "description": "跳过的条数" }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "read_file",
      "description": "按行区间读取文本文件（路径相对于 root）；返回 total_lines 和 next_start_line（读完时为 null），可据此继续读取",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": { "type": "string", "minLength": 1, "description": "相对于 root 的文件路径" },
          "start_line": { "type": "integer", "minimum": 1, "default": 1, "description": "起始行号（从 1 开始）" },
          "max_lines": { "type": "integer", "minimum": 1, "maximum": 500, "default": 200, "description": "最多读取的行数" }
        },
        "required": ["path"],
        "additionalProperties": false
      }
    },
    {
      "name": "search_text",
      "description": "在目录下的文本文件中搜索关键词（不区分英文大小写），返回匹配的文件、行号和该行内容，支持分页",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": { "type": "string", "minLength": 1, "description": "关键词（按字面匹配）" },
          "path": { "type": "string", "default": ".", "description": "相对于 root 的搜索目录" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20, "description": "每页数量" },
          "offset": { "type": "integer", "minimum": 0, "default": 0, "description": "跳过的条数" }
        },
        "required": ["query"],
        "additionalProperties": false
      }
    }
  ]
}
